#===============================================================================
# Scaling
#===============================================================================

    units = si
    unit_temperature = 1
    unit_length      = 1
    unit_viscosity   = 1
    unit_stress      = 1

#===============================================================================
# Grid & discretization parameters
#===============================================================================

# Number of cells for all segments
    nel_x   =  128
    nel_y   =  2
    nel_z   =  128

# Coordinates of all segments (including start and end points)
    coord_x =  -25000 25000
    coord_y =  -100 100
    coord_z =  -50000.0 0.0
# Number of markers per cell
    nmark_x =  3
    nmark_y =  3
    nmark_z =  3

# Periodic geometry flags
# WARNING! only implemented for x-direction
	periodic = 1

#===============================================================================
# Time stepping parameters
#===============================================================================

    time_end         =  1e12     # simulation end time
    dt               =  1e7     # initial time step
    dt_min           =  0.001     # minimum time step (declare divergence if lower value is attempted)
    dt_max           =  1e8     # maximum time step
    nstep_max        =  10000     # maximum allowed number of steps (lower bound: time_end/dt_max)
    nstep_out        =  1     # save output every n steps; Set this to -1 to deactivate saving output
    nstep_rdb        =  100     # save restart database every n steps

#===============================================================================
# Free surface
#===============================================================================


#===============================================================================
# Boundary conditions
#===============================================================================
	
    noslip           =  0 0 0 0 1 0     # No-slip boundary flag mask (left right front back bottom top)
    temp_top         =  1250.0     # Constant temperature on the top boundary
    temp_bot         =  1250.0     # Constant temperature on the bottom boundary  
    #exy_num_periods  =  1     # exz_num_periods
    #exy_strain_rates  =  0.002     # exz_strain_rates


# temperature on the top & bottom boundaries [usually constant]
    temp_top   =  1250.0
    temp_bot   =  1250.0


    <VelBoxStart>
    	cenX     =   0    # X-coordinate of center of box
    	cenY     =   0.0  #     Y-coordinate of center of box
    	cenZ     =   -1000    # Z-coordinate of center of box
   	    widthX   =   50000      # Width of box in x-direction
    	widthY   =   200.0        # Width of box in y-direction
    	widthZ   =   2000    # Width of box in z-direction
    	vx       =   4e-9   # Vx velocity of box (default is unconstrained)
    	vy       =   0   # Vx velocity of box (default is unconstrained)
    	z        =   0   # Vx velocity of box (default is unconstrained)
    	advect   =   0          # box advection flag
    <VelBoxEnd>


#===============================================================================
# Solution parameters & controls
#===============================================================================

    gravity          =  0.0 0.0 0.0     # gravitational acceleration vector
    init_guess       =  0     # create an initial guess step (using constant viscosity `eta_ref` before starting the simulation
    p_lim_plast      =  1     # limit pressure at first iteration for plasticity
    act_p_shift      =  0     # pressure shift activation flag (enforce zero pressure on average in the top cell layer); note: this overwrites p_shift above!
    eta_min          =  10.0     # viscosity lower bound [Pas]
    eta_max          =  1.0e25     # viscosity upper limit [Pas]   
    eta_ref          =  1.0e2     # Reference viscosity (used for the initial guess) [Pas]
	p_shift = 5e6


#===============================================================================
# Solver options
#===============================================================================

    SolverType       =  direct     # solver employed [`"direct"` or `"multigrid"`]
    DirectSolver     =  mumps     # mumps/superlu_dist/pastix/umfpack  (requires these external PETSc packages to be installed!)
    DirectPenalty    =  10000.0     # penalty parameter [employed if we use a direct solver]

#===============================================================================
# Model setup & advection
#===============================================================================

    msetup           =  geom     
    rand_noise       =  1     # add random noise to the particle location
    bg_phase         =  0     # background phase ID
    advect           =  basic     # advection scheme; options=`none` (no advection); `basic` (Euler classical implementation [default]); `Euler` (Euler explicit in time); `rk2` (Runge-Kutta 2nd order in space)
    interp           =  stag     # velocity interpolation scheme; options = `stag` (trilinear interpolation from FDSTAG points), `minmod` ( MINMOD interpolation to nodes, trilinear interpolation to markers + correction), `stagp` ( STAG_P empirical approach by T. Gerya) 
    mark_ctrl        =  subgrid     # marker control type; options are `subgrid` (default; marker control enforced over fine scale grid), `none` (none), `basic` (AVD for cells + corner insertion), and `avd` (pure AVD for all control volumes)
    nmark_lim        =  10 100     # min/max number per cell (marker control)
    nmark_sub        =  3     # max number of same phase markers per subcell (subgrid marker control)



# GEOMETRY
    <LayerStart>
        phase       = 0
        top         = 0.0
        bottom      = -50000.0
    <LayerEnd>

    <LayerStart>
        phase       = 1
        top         = -24500.0
        bottom      = -25500.0
    <LayerEnd>
    
    #<BoxStart>
    #    phase       = 1
    #    bounds      = -1000.0 1000 -100.0 100.0 -25500.0 -24500.0 # box bound coordinates: left, right, front, back, bottom, top
    #<BoxEnd>

#===============================================================================
# Output options
#===============================================================================

    out_file_name    =  simple_shear_pbc     # output file name
    out_dir          =       # output directory
    write_VTK_setup  =  true     # write VTK initial model setup
    out_pvd          =  1     # activate writing .pvd file
    out_phase        =  1     # dominant phase
    out_density      =  1     # density
    out_visc_total   =  1     # total (viscoelastoplastic) viscosity
    out_visc_creep   =  1     # creep viscosity
    out_velocity     =  1     # velocity
    out_pressure     =  1     # (dynamic) pressure
    out_tot_press    =  0     # total pressure
    out_eff_press    =  0     # effective pressure
    out_over_press   =  0     # out_over_press
    out_litho_press  =  0     # lithospheric pressure
    out_pore_press   =  0     # pore pressure
    out_temperature  =  1     # temperature
    out_dev_stress   =  0     # deviatoric strain rate tensor
    out_j2_dev_stress  =  1     # second invariant of deviatoric stress tensor
    out_strain_rate  =  0     # deviatoric strain rate tensor
    out_j2_strain_rate  =  1     # second invariant of strain rate tensor
    out_shmax        =  0     # sh max
    out_ehmax        =  0     # eh max
    out_yield        =  1    # yield stress
    out_rel_dif_rate  =  0     # relative proportion of diffusion creep strainrate
    out_rel_dis_rate  =  0     # relative proportion of dislocation creep strainrate
    out_rel_prl_rate  =  0     # relative proportion of peierls creep strainrate
    out_rel_pl_rate  =  1     # relative proportion of plastic strainrate
    out_plast_strain  =  1     # accumulated plastic strain
    out_plast_dissip  =  1     # plastic dissipation
    out_tot_displ    =  1     # total displacement
    out_moment_res   =  1     # momentum residual
    out_cont_res     =  1     # continuity residual
    out_energ_res    =  0     # energy residual
    out_melt_fraction  =  0     # Melt fraction
    out_fluid_density  =  0     # fluid density
    out_conductivity  =  0     # conductivity
    out_vel_gr_tensor  =  0     # velocity gradient tensor
    out_surf         =  0     # activate surface output
    out_surf_pvd     =  0     # activate writing .pvd file
    out_surf_velocity  =  0     # surface velocity
    out_surf_topography  =  0     # surface topography 
    out_surf_amplitude  =  0     # amplitude of topography (=topo-average(topo))
    out_mark         =  0     # activate marker output
    out_mark_pvd     =  0     # activate writing .pvd file
    out_avd          =  0     # activate AVD phase output
    out_avd_pvd      =  0     # activate writing .pvd file
    out_avd_ref      =  0     # AVD grid refinement factor
    out_ptr          =  0     # activate
    out_ptr_ID       =  0     # ID of the passive tracers
    out_ptr_phase    =  0     # phase of the passive tracers
    out_ptr_Pressure  =  0     # interpolated pressure
    out_ptr_Temperature  =  0     # temperature
    out_ptr_MeltFraction  =  0     # melt fraction computed using P-T of the marker
    out_ptr_Active   =  0     # option that highlight the marker that are currently active
    out_ptr_Grid_Mf  =  0     # option that allow to store the melt fraction seen within the cell

#===============================================================================
# Passive tracers 
#===============================================================================
#===============================================================================
# Material phase parameters
#===============================================================================

   # Define softening laws (maximum 10)
   # Define phase aggregates (for visualization purposes)
   # Define material properties for all phases (maximum 32)
   # By default all rheological mechanisms are deactivated
   # List only active parameters in the material data block

 	# Define properties of block
	<MaterialStart>
		ID  = 0 # phase id
		T   = 273.0
		rho = 2700 # density
		eta = 5e26
		G = 3e10
		nu = 0.25
        #ch         = 1e7    # cohesion
        #fr         = 36.86   # friction angle
	<MaterialEnd>

	# Define properties of weak zone
	<MaterialStart>
		ID  = 1   # phase id
		T   = 273.0
		rho = 2700   # density
		#eta = 1e-3
		G = 3e10
		nu = 0.25
        #ch         = 1e1    # cohesion
        #fr         = 6.86   # friction angle
	<MaterialEnd>


#===============================================================================
# Define phase transitions
#===============================================================================

   # Define Phase Transition laws (maximum 10)
#===============================================================================
# PETSc options
#===============================================================================

<SolverOptionsStart>

	#linear_tolerances       =  1e-5 1e-7   1000
	#view_solvers            =  1                     # show linear solver configuration
	#monitor_solvers         =  1                     # show linear iteration convergence
	#set_linear_problem      =  1                     # linear problem activation flag (skip nonlinear iteration)
	#use_mat_free_jac        =  0
	stokes_solver           =  block_direct         # [block_direct, coupled_mg, block_mg, wbfbt]
     #stokes_solver           =  coupled_mg         # [block_direct, coupled_mg, block_mg, wbfbt]
    
	#block_tolerances        =  1e-3 30              # rtol, maxit (block solver settings for block_mg, wbfbt)
	#num_mat_free_levels     =  0                    # (only for coupled_mg)
	#smoother_type           =  heavy                # [light (richardson + jacobi), intermediate (chebyshev + sor), heavy (gmres + bjacobi)]
#	##smoother_pc             =  jacobi               # [jacobi, sor, bjacobi, asm]
	#smoother_num_sweeps     =  20
	#coarse_cells_per_cpu    =  2048                 # (-1 = all cpus are used by coarse solve)
	#coarse_solver           =  direct               # [direct, hypre, bjacobi, asm] (hypre, bjacobi and asm use gmres)
	#coarse_tolerances       =  1e-2 30              # rtol, maxit (gmres settings for hypre, bjacobi and asm)
	#subdomain_num_cells     = -1                    # (only for bjacobi and asm) (-1 = one subdomain per cpu) 
    init_thermal_solver     = default
<SolverOptionsEnd>

<PetscOptionsStart>
    #-vs_pc_factor_mat_solver_type mumps
	-snes_type ksponly 		# no nonlinear solver
	-da_refine_y 1
	#-js_ksp_monitor 		# display how the inner iterations converge
	-js_ksp_rtol 1e-6
	-js_ksp_max_it 150
#-jp_type mg 
#-gmg_pc_type mg 
#-gmg_pc_mg_log 
#-gmg_pc_mg_galerkin 
#-gmg_pc_mg_type multiplicative 
#-gmg_pc_mg_cycle_type v 
#-gmg_pc_mg_levels 2
#-gmg_mg_levels_ksp_type richardson 
#-gmg_mg_levels_ksp_richardson_scale 0.5 
#-gmg_mg_levels_ksp_max_it 10 
#-gmg_mg_levels_pc_type jacobi
#-gmg_mg_coarse_pc_type telescope
#-gmg_mg_coarse_telescope_ksp_type preonly 
#-gmg_mg_coarse_telescope_pc_type lu
#-gmg_mg_coarse_telescope_ksp_type fgmres 
#-gmg_mg_coarse_telescope_pc_type bjacobi
#-gmg_mg_coarse_telescope_ksp_max_it 60
<PetscOptionsEnd>

