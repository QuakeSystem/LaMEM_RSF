# This shows an example with 10 falling spheres in non-dimensional units, 
# using a multigrid solver. Linear viscosity is assumed.
# It runs for 1 timestep and creates output every timestep.
#
# This setup is a useful test for multigrid solvers (more realistic than a single sphere)

#===============================================================================
# Scaling
#===============================================================================

	units            = si		# geological units 
	
	unit_temperature = 1
	unit_length      = 1
	unit_viscosity   = 1
	unit_stress      = 1
#===============================================================================
# Time stepping parameters
#===============================================================================

	time_end  = 5  # simulation end time
	dt        = 1e-5    # time step
	dt_min    = 1e-9  # minimum time step (declare divergence if lower value is attempted)
	dt_max    = 5e-3   # maximum time step
	inc_dt    = 30.1   # time step increment per time step (fraction of unit)
	CFL       = 0.5   # CFL (Courant-Friedrichs-Lewy) criterion
	CFLMAX    = 0.5   # CFL criterion for elasticity
	nstep_max = 10000    # maximum allowed number of steps (lower bound: time_end/dt_max)
	nstep_out = 1     # save output every n steps
	nstep_rdb = 0     # save restart database every n steps


    #num_dt_periods  = 2              # number of time stepping periods
    #time_dt_periods = 0 0.1 0.29 1.9 # timestamps where timestep should be fixed (first entry has to 0)
    #step_dt_periods = 1e-6 4e-4 1e-4 1e-5   # target timesteps ar timestamps above 
#===============================================================================
# Grid & discretization parameters
#===============================================================================

# Number of cells for all segments

	nel_x =  128
	nel_y = 2
	nel_z = 128

# Coordinates of all segments (including start and end points)

	coord_x = -10000 10000
	coord_y = -100 100
	coord_z = -20000 0

#===============================================================================
# Free surface
#===============================================================================

# Default

#===============================================================================
# Boundary conditions
#===============================================================================

# Default
# No-slip boundary flag mask (left right front back bottom top)

#===============================================================================
# Solution parameters & controls
#===============================================================================

	gravity        = 0.0 0.0 -10.0   # gravity vector
	FSSA           = 1.0            # free surface stabilization parameter [0 - 1]
	init_guess     = 1              # initial guess flag
	eta_min        = 1e-3           # viscosity upper bound
	eta_ref        = 1e-3
	inertia        = 1
	eta_max        = 1e18           # viscosity lower limit
	init_lith_pres  = 1              # initial pressure with lithostatic pressure (stabilizes compressible setups in the first steps)
p_shift 		= 1e5 
#===============================================================================
# Solver options
#===============================================================================
	SolverType 			=	direct 	# solver [direct or multigrid]

	
	
#===============================================================================
# Model setup & advection
#===============================================================================

	msetup         = geom              # setup type
	nmark_x        = 3                 # markers per cell in x-direction
	nmark_y        = 3                 # ...                 y-direction
	nmark_z        = 3                 # ...                 z-direction
	bg_phase       = 0                 # background phase ID
	rand_noise     = 1                 # random noise flag
	advect         = rk2               # advection scheme
	interp         = stag             # velocity interpolation scheme
	stagp_a        = 0.7               # STAG_P velocity interpolation parameter
	mark_ctrl      = basic               # marker control type
	nmark_lim      = 16 100            # min/max number per cell

    temp_top                =   273.0
    temp_bot                =   273.0                              # if only one value is given, it is assumed to be constant with time
	

# Geometric primitives:
	

	# 2
	<SphereStart>	
		phase  = 1
		center = 0 0 -10000  
		radius = 4000
	<SphereEnd>	

    <LayerStart>
        phase       = 2
        top         = -15000
        bottom      = -20000.0
    <LayerEnd>

#===============================================================================
# Output
#===============================================================================

# Grid output options (output is always active)

	out_file_name       = Spheres_multigrid # output file name
	out_pvd             = 1       	# activate writing .pvd file
    out_phase           = 1
    out_density         = 1
    out_visc_total      = 1
    out_visc_creep      = 1
    out_velocity        = 1
    out_velocity_old   = 1
    out_pressure        = 0
    out_tot_press       = 0
    out_eff_press       = 0
    out_over_press      = 0
    out_litho_press     = 0
    out_pore_press      = 0
    out_temperature     = 0
    out_dev_stress      = 1
    out_j2_dev_stress   = 1
    out_strain_rate     = 1
    out_j2_strain_rate  = 1
    out_shmax           = 0
    out_ehmax           = 0
    out_yield           = 1
    out_plast_strain    = 1     # accumulated plastic strain
    out_plast_dissip    = 1     # plastic dissipation
    out_tot_displ       = 1
    out_moment_res      = 1
    out_cont_res        = 0
    out_vel_gr_tensor   = 0 
# AVD phase viewer output options (requires activation)

	out_avd     = 1 # activate AVD phase output
	out_avd_pvd = 1 # activate writing .pvd file
	out_avd_ref = 3 # AVD grid refinement factor


#===============================================================================
# Material phase parameters
#===============================================================================

	# Define properties of matrix
	<MaterialStart>
		ID  = 0 # phase id
		T   = 273.0
		rho = 1 # density
		eta = 1e-3
	<MaterialEnd>

	# Define properties of spheres
	<MaterialStart>
		ID  = 1   # phase id
		T   = 273.0
		rho = 7000   # density
		#eta = 1e-3
		G = 1e8
		nu = 0.3
	<MaterialEnd>

	# Define properties of block
	<MaterialStart>
		ID  = 2   # phase id
		T   = 273.0
		rho = 7000   # density
		#eta = 1e-3
		G = 1e8
		nu = 0.3
	<MaterialEnd>

#===============================================================================
# PETSc options
#===============================================================================

<SolverOptionsStart>

	linear_tolerances       =  1e-5 1e-7   1000
	#view_solvers            =  1                     # show linear solver configuration
	#monitor_solvers         =  1                     # show linear iteration convergence
	#set_linear_problem      =  1                     # linear problem activation flag (skip nonlinear iteration)
	#use_mat_free_jac        =  0
	stokes_solver           =  block_direct         # [block_direct, coupled_mg, block_mg, wbfbt]
     #stokes_solver           =  coupled_mg         # [block_direct, coupled_mg, block_mg, wbfbt]
    
	block_tolerances        =  1e-3 30              # rtol, maxit (block solver settings for block_mg, wbfbt)
	#num_mat_free_levels     =  0                    # (only for coupled_mg)
	#smoother_type           =  heavy                # [light (richardson + jacobi), intermediate (chebyshev + sor), heavy (gmres + bjacobi)]
#	##smoother_pc             =  jacobi               # [jacobi, sor, bjacobi, asm]
	#smoother_num_sweeps     =  20
	#coarse_cells_per_cpu    =  2048                 # (-1 = all cpus are used by coarse solve)
	#coarse_solver           =  direct               # [direct, hypre, bjacobi, asm] (hypre, bjacobi and asm use gmres)
	#coarse_tolerances       =  1e-2 30              # rtol, maxit (gmres settings for hypre, bjacobi and asm)
	#subdomain_num_cells     = -1                    # (only for bjacobi and asm) (-1 = one subdomain per cpu) 
    init_thermal_solver     = default
<SolverOptionsEnd>

<PetscOptionsStart>
    #-vs_pc_factor_mat_solver_type mumps
	-snes_type ksponly 		# no nonlinear solver
	-da_refine_y 1
	#-js_ksp_monitor 		# display how the inner iterations converge
	-js_ksp_rtol 1e-6
	-js_ksp_max_it 150
#-jp_type mg 
#-gmg_pc_type mg 
#-gmg_pc_mg_log 
#-gmg_pc_mg_galerkin 
#-gmg_pc_mg_type multiplicative 
#-gmg_pc_mg_cycle_type v 
#-gmg_pc_mg_levels 2
#-gmg_mg_levels_ksp_type richardson 
#-gmg_mg_levels_ksp_richardson_scale 0.5 
#-gmg_mg_levels_ksp_max_it 10 
#-gmg_mg_levels_pc_type jacobi
#-gmg_mg_coarse_pc_type telescope
#-gmg_mg_coarse_telescope_ksp_type preonly 
#-gmg_mg_coarse_telescope_pc_type lu
#-gmg_mg_coarse_telescope_ksp_type fgmres 
#-gmg_mg_coarse_telescope_pc_type bjacobi
#-gmg_mg_coarse_telescope_ksp_max_it 60
<PetscOptionsEnd>

#===============================================================================
