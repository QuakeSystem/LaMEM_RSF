# Standing SH wave with inertia.
#
# Periodic in x, no-slip on the top and the bottom, free-slip on the front and back.
# Initial velocity is vx = V0 sin(n π (z-zbot)/H), vy = vz = 0, stress = 0.
# Analytical solution (elastic, Vs = sqrt(G/rho), k = n π/H, ω = Vs k):
#   vx  = V0 sin(k z) cos(ω t)
#   ux  = (V0/ω) sin(k z) sin(ω t)
#   txz = (G k V0/ω) cos(k z) sin(ω t)
#
# Reference run below is the fine member of the convergence series
# (nel_z = 32, 32 steps over one eighth of a period).
# SHWave_analytics.jl rewrites nel_z, dt, time_end and nstep_max for the other members.

#===============================================================================
# Scaling
#===============================================================================

	units = si

	unit_temperature = 1
	unit_length      = 1
	unit_viscosity   = 1
	unit_stress      = 1

#===============================================================================
# Time stepping parameters
#===============================================================================

	time_end  = 7.9056941504209485e-02
	dt        = 2.4705294220065464e-03
	dt_min    = 2.4705294220065464e-03
	dt_max    = 2.4705294220065464e-03
	dt_out    = 1.0e6
	inc_dt    = 0
	CFL       = 0.5
	CFLMAX    = 0.9
	nstep_max = 40
	nstep_out = 1

#===============================================================================
# Grid & discretization parameters
#===============================================================================

	nel_x = 4
	nel_y = 1
	nel_z = 32

	coord_x = 0.0 1000.0
	coord_y = 0.0 250.0
	coord_z = 0.0 1000.0

	periodic = 1

#===============================================================================
# Boundary conditions
#===============================================================================

# left right front back bottom top; periodic x forbids no-slip on the left and right
	noslip = 0 0 0 0 1 1

	pres_top = 0.0

	temp_top = 0.0
	temp_bot = 0.0

#===============================================================================
# Solution parameters & controls
#===============================================================================

	gravity        = 0.0 0.0 0.0
	act_temp_diff  = 0
	init_guess     = 0
	p_litho_visc   = 0
	p_litho_plast  = 0
	p_lim_plast    = 0
	eta_min        = 1.0e-3
	eta_max        = 1.0e25
	eta_ref        = 1.0e20
	inertia        = 1
	old_vel_advect = 0
	init_shwave    = 1
	shwave_V0      = 1.0e-4
	shwave_n       = 1

#===============================================================================
# Model setup & advection
#===============================================================================

	msetup    = geom
	nmark_x   = 3
	nmark_y   = 3
	nmark_z   = 3
	rand_noise = 0
	bg_phase  = 0
	interp    = stag
	mark_ctrl = none

	<LayerStart>
		phase  = 0
		top    = 1000.0
		bottom = 0.0
	<LayerEnd>

#===============================================================================
# Output
#===============================================================================

	out_file_name   = SHWave
	out_pvd         = 1
	out_phase       = 0
	out_density     = 0
	out_visc_total  = 0
	out_visc_creep  = 0
	out_velocity    = 1
	out_pressure    = 0
	out_dev_stress  = 1
	out_tot_displ   = 1
	out_temperature = 0

#===============================================================================
# Material phase parameters
#===============================================================================

	<MaterialStart>
		ID  = 0
		rho = 3000
		eta = 1.0e20
		G   = 3.0e10
		Cp  = 1000
		k   = 2.5
	<MaterialEnd>

#===============================================================================
# Solver options
#===============================================================================

<SolverOptionsStart>

	nonlinear_tolerances = 1e-8 1e-12 30
	linear_tolerances    = 1e-10 1e-14 100
	picard_to_newton     = 1e-2 1 1.2 20
	monitor_solvers      = 0
	stokes_solver        = block_direct
	direct_solver_type   = default

<SolverOptionsEnd>
